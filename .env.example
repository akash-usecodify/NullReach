# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Stripe Secret Key (e.g. sk_test_... or sk_live_...) from https://dashboard.stripe.com/apikeys
# Used server-side to create Payment Intents and process lead credit top-ups.
STRIPE_SECRET_KEY=

# STRIPE_PUBLISHABLE_KEY: Stripe Publishable Key (e.g. pk_test_... or pk_live_...) from https://dashboard.stripe.com/apikeys
# Used to initialize client-side Stripe checkout and secure payment elements.
STRIPE_PUBLISHABLE_KEY=

# RESEND_API_KEY: (Recommended) API key from https://resend.com/api-keys for sending welcome emails & admin registration alerts
RESEND_API_KEY=

# SENDER_EMAIL: The verified sender email address on your email provider (e.g., 'NullReach <alerts@yourdomain.com>' or 'onboarding@resend.dev' for testing)
SENDER_EMAIL=NullReach <onboarding@resend.dev>

# ADMIN_ALERT_EMAIL: The destination email where new user registration alerts will be sent (e.g. akashsuresh2403@gmail.com)
ADMIN_ALERT_EMAIL=akashsuresh2403@gmail.com

# SENDGRID_API_KEY: Optional alternative transactional email API key from https://sendgrid.com
SENDGRID_API_KEY=
